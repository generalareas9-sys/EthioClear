# =====================================================================
# EthioClear Backend — Environment Configuration Template
# Copy this file to `.env` and fill in real values.
# NEVER commit the actual `.env` file with production secrets.
# =====================================================================

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_BASE_PATH=/api

# ---------------------------------------------------------------------
# Frontend origin(s) allowed by CORS (comma-separated for multiple)
# In production on Render, set:
# CLIENT_ORIGIN=https://ethio-clear-3yxy.vercel.app
# ---------------------------------------------------------------------
CLIENT_ORIGIN=https://ethio-clear-3yxy.vercel.app,http://localhost:5173,http://localhost:4173

# ---------------------------------------------------------------------
# PostgreSQL Database (Neon / Render / Local)
# ---------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=ethioclear_user
PGPASSWORD=change_me
PGDATABASE=ethioclear_db
# In production, provide the full DATABASE_URL (overrides discrete PG* vars):
# DATABASE_URL=postgresql://user:password@ep-host.region.neon.tech/ethioclear_db?sslmode=require
PG_SSL=true

# ---------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------
# Bcrypt
# ---------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12

# ---------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------------------------------
# File Storage
# ---------------------------------------------------------------------
UPLOAD_DIR=storage/uploads
CERTIFICATE_DIR=storage/certificates
TEMP_DIR=storage/temp
MAX_UPLOAD_SIZE_MB=5

# ---------------------------------------------------------------------
# Certificate Verification & Live Frontend URL
# Used for QR code link generation and verification redirects.
# In production on Render, set:
# VERIFICATION_BASE_URL=https://ethio-clear-3yxy.vercel.app/verify
# ---------------------------------------------------------------------
VERIFICATION_BASE_URL=https://ethio-clear-3yxy.vercel.app/verify
FRONTEND_BASE_URL=https://ethio-clear-3yxy.vercel.app
