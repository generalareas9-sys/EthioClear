# =====================================================================
# EthioClear Frontend — Environment Configuration Template
# Copy this file to `.env` for local development.
# On Vercel: set VITE_API_URL in Project Settings -> Environment Variables
# =====================================================================

# Deployed backend API URL (e.g., Render, Railway, or VPS)
# When deploying to production on Vercel, set this to your live backend URL:
# Example: https://ethioclear-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Legacy fallback key (supported alongside VITE_API_URL)
VITE_API_BASE_URL=http://localhost:5000/api
